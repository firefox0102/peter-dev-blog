---
import { Fragment } from "react"
import Layout from "@layouts/Layout.astro"
import Header from "@components/Header.astro"
import Hr from "@components/Hr.astro"
import { githubSocial, linkedInSocial } from "@config"
import { ExperiencePageCompanyBlock } from "@components/ExperiencePageCompanyBlock"
import { ExperienceGroupLeftAdornment } from "@components/ExperienceGroupLeftAdornment"
import { SkillsBlock } from "@components/SkillsBlock"
import socialIcons from "@assets/socialIcons"
import LinkButton from "@components/LinkButton.astro"
---

<Layout>
  <Header />
  <main id="main-content">
    <section class="content-section">
      <div class="flex items-end justify-between">
        <h2 class="mr-2">Peter Finn</h2>
        <p>Seattle, Wa</p>
      </div>
      <div class="flex items-end justify-between">
        <p class="font-medium">
          <Fragment set:html={socialIcons["CodePen"]} />
          peterfinn.dev
        </p>
        <LinkButton
          href={githubSocial.href}
          className="link-button text-xs flex items-center"
          title={githubSocial.linkTitle}
        >
          <Fragment set:html={socialIcons["Github"]} />
          {githubSocial.href}
        </LinkButton>
      </div>
      <div class="flex items-end justify-between">
        <p class="">
          <Fragment set:html={socialIcons["Mail"]} />
          peter.finn.code@gmail.com
        </p>
        <LinkButton
          href={linkedInSocial.href}
          className="link-button flex text-xs items-center"
          title={linkedInSocial.linkTitle}
        >
          <Fragment set:html={socialIcons["LinkedIn"]} />
          {linkedInSocial.href}
        </LinkButton>
      </div>
    </section>

    <Hr />

    <section class="content-section">
      <h2>Current Top Skills</h2>
      <SkillsBlock
        skillLabels={[
          "React",
          "TypeScript",
          "JavaScript",
          "RTKQuery/Redux",
          "E2E Testing with Cypress/Playwright",
          "Leading Features",
        ]}
      />
    </section>

    <Hr />

    <section class="content-section">
      <h2>Experience</h2>

      <!-- 1Password Block -->
      <div>
        <ExperiencePageCompanyBlock
          companyName="1Password"
          startDate="December 2023"
          endDate="Present"
        />
        <div class="flex">
          <!-- <ExperienceGroupLeftAdornment /> -->
          <div class="flex flex-col">
            <div class="experience-block">
              <h5>Senior Frontend Engineer</h5>
              <p>December 2023 - Present</p>
              <p>
                Frontend focused full stack developer on the 1Password Admin
                Experience team. Responsibilities included leading projects and
                ceremonies on a squad of developers, mentoring junior
                developers, and helping organize the Frontend Guild.
              </p>
            </div>
            <div class="experience-block">
              <h4>🎉 Things I'm Proud Of 🎉</h4>
              <ul>
                <li>
                  ⭐ Recipient of 2024 Product & Engineering "Team Player" core values award
                </li>
                <li>
                  Tech lead for 1Password admin web app navigation and information architecture redesign. 6 month project involved collecting input and feedback from multiple teams and departments, iteratively releasing and testing with a subset of customers, and continuously improving before the full reveal RSA Conf 2025.
                </li>
                <li>
                  Leading by example - updated the 1Password Admin web app from
                  monolithic Class Components (with no tests) to modern React
                  code using Hooks and React Testing Library, teaching various
                  refactoring patterns to more junior engineers.
                </li>
                <li>
                  Lead multi team effort to build a new Email focused
                  microservice to help incrementally break up the monolithic
                  1Password backend.
                </li>
                <li>
                  Tech Lead for multiple features for the Admin web
                  application including rebuilding the Team Invitations flow,
                  Email Customization, and implementation of the company design
                  system in the web app.
                </li>
                <li>
                  Helped train team on unit/integration testing with React
                  Testing Library, and End to End testing with Playwright.
                </li>
              </ul>
              <SkillsBlock
                label="Skills & Stack: "
                skillLabels={[
                  "React",
                  "TypeScript",
                  "Testing Library",
                  "Golang",
                  "Playwright",
                ]}
              />
            </div>
          </div>
        </div>
      </div>

      <!-- DataGrail Block -->
      <div>
        <ExperiencePageCompanyBlock
          companyName="DataGrail"
          startDate="August 2020"
          endDate="December 2023"
        />
        <div class="flex">
          <!-- <ExperienceGroupLeftAdornment /> -->
          <div class="flex flex-col">
            <div class="experience-block">
              <h5>Staff Software Engineer</h5>
              <p>August 2020 - December 2023</p>
              <p>
                Hired on as the first Frontend focused developer for the
                engineering team. Engineering teams were struggling to build out
                a delightful, interactive web experience for customers while
                also keeping things maintainable and tested. Initial goals were
                to migrate away from SSR (Ruby Rails + HAML) to React, educate
                team on how to unit test frontend code, introduce TypeScript,
                improve tooling and infrastructure, improve developer enablement
                by creating a culture of learning and continuous improvement,
                and much more.
              </p>
            </div>
            <div class="experience-block">
              <h4>🎉 Things I'm Proud Of 🎉</h4>
              <ul>
                <li>Owned the Frontend architecture of the entire platform.</li>
                <li>
                  Took over as manager of the Request Manager team to lead the
                  discovery, design, and delivery of DataGrail's first analytics
                  dashboard offering which lead to a 76% reduction in overdue
                  Privacy Requests in 6 months.
                </li>
                <li>
                  Introduced and trained the team on the usage of React Testing
                  Library, unit testing best practices, Cypress for E2E testing,
                  eslint and Prettier, the use of themes with Styled Components,
                  a Design Review process, and more!
                </li>
                <li>
                  Project Lead for multiple Frontend focused, mission critical
                  projects at once to help secure SalesForce as a customer at an
                  early stage.
                </li>
                <li>
                  Successfully rolled out a unified Design System, which was
                  implemented as a custom theme on top of React Material UI
                  (learned from my mistakes at SalesLoft and didn't start from
                  scratch).
                </li>
                <li>
                  Participated in two separate revamps of the Company Core
                  Values during this tenure, as well as smaller initiatives
                  designed to help the company adapt to remote work effectively.
                </li>
              </ul>
              <SkillsBlock
                label="Skills & Stack: "
                skillLabels={[
                  "TypeScript",
                  "React",
                  "Cypress",
                  "Testing Library",
                  "Ruby on Rails",
                ]}
              />
            </div>
          </div>
        </div>
      </div>

      <!-- SalesLoft Block -->
      <div>
        <ExperiencePageCompanyBlock
          companyName="SalesLoft"
          startDate="Oct 2016"
          endDate="August 2020"
        />
        <div class="flex">
          <!-- <ExperienceGroupLeftAdornment /> -->
          <div class="flex flex-col">
            <div class="experience-block">
              <h5>Senior Frontend Engineer</h5>
              <p>Oct 2016 - August 2020</p>
              <p>
                Hired on as an early Frontend focused engineer when the company
                was around 80 people (Series A/B Stage). Quickly established
                myself as a passionate proponent of best practices, peer
                feedback, and company core values. Worked on many various
                delivery teams delivering excellent products and features
                throughout the Sales Enablement stack.
              </p>
            </div>
            <div class="experience-block">
              <h4>🎉 Things I'm Proud Of 🎉</h4>
              <ul>
                <li>
                  Selected to represent the SalesLoft engineering organization
                  on the acquisition and integration of two separate company
                  platforms into the SalesLoft ecosystem. Both projects were the
                  #1 company objective at their respective times, and each were
                  completed in less than 90 days. Involved technologies such as
                  React, Typescript, and a bit of Golang + Ruby.
                </li>
                <li>
                  ⭐ Nominated by manager to serve on the SalesLoft Core Values
                  interview team, and to attend the LEAD program (6 month
                  leadership development program).
                </li>
                <li>
                  Founding member of the Frontend Enablement Team (Building the
                  SalesLoft Design System and other packages, advising teams on
                  Frontend Architectural Patterns, and educating developers on
                  best practices).
                </li>
                <li>Organized and lead the Frontend Internal Meetups.</li>
                <li>
                  ⭐ Recipient of the company wide SalesLoft Star award (Jan 2018).
                </li>
                <li>
                  "React Evangelist" at SalesLoft, helping to lead the effort to
                  re-write the entire frontend application from AngularJS into
                  React.
                </li>
                <li>
                  Led the project to convert our build pipeline from the Rails
                  Asset Pipeline to Gulp, then Gulp to Webpack v4.
                </li>
              </ul>
              <SkillsBlock
                label="Skills & Stack: "
                skillLabels={[
                  "TypeScript",
                  "React",
                  "Redux",
                  "Testing Library",
                  "AngularJS",
                  "Ruby on Rails",
                ]}
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Cardlytics Block -->
      <div>
        <ExperiencePageCompanyBlock
          companyName="Cardlytics"
          startDate="Jan 2015"
          endDate="Oct 2016"
        />
        <div class="flex">
          <!-- <ExperienceGroupLeftAdornment /> -->

          <div class="flex flex-col">
            <div class="experience-block">
              <h5>Full Stack Engineer</h5>
              <p>
                Full Stack developer on various Agile teams that created
                internal content management systems for running high volume
                advertising campaigns (millions of calls per second). Main
                responsibilities include creating AngularJS apps, ASP.NET APIs,
                working with ORMs and MySQL databases, and collaborating with
                the UX team to design and implement great looking web apps. Also
                balanced daily development responsibilities with many R&D,
                “Black Ops”, and internally requested side projects.
              </p>
            </div>
            <SkillsBlock
              label="Skills & Stack: "
              skillLabels={[
                "JavaScript",
                "AngularJS",
                "UX Design",
                "ASP.NET",
                "C#",
              ]}
            />
          </div>
        </div>
      </div>

      <!-- Clearleap Block -->
      <div>
        <ExperiencePageCompanyBlock
          companyName="Clearleap"
          startDate="May 2014"
          endDate="Dec 2014"
        />
        <div class="flex">
          <!-- <ExperienceGroupLeftAdornment /> -->
          <div class="flex flex-col">
            <div class="experience-block">
              <h5>Full Stack Engineer</h5>
              <p>
                Created and maintained an internal web application used to run
                and manage the company automated testing suites. Application was
                used for weekly reports to executive team. Application built
                with JavaScript, Java, Groovy on Grails, Bootstrap, Apache
                JMeter, Quartz, PostgreSQL.
              </p>
            </div>
            <SkillsBlock
              label="Skills & Stack: "
              skillLabels={[
                "JavaScript",
                "AngularJS",
                "Java",
                "Groovy",
                "UX Design",
                "ASP.NET",
                "QA Automation Testing",
              ]}
            />
          </div>
        </div>
      </div>
    </section>

    <Hr />

    <section class="content-section">
      <h2>Education</h2>
      <ExperiencePageCompanyBlock
        companyName="Southern Polytechnic State University"
        startDate="B.S. 2014"
      />
    </section>
  </main>

  <style>
    .content-section {
      @apply pb-2 pt-2;
    }

    .content-section h2,
    .content-section h3,
    .content-section h4 {
      @apply text-sm font-semibold tracking-wide;
    }

    .content-section p {
      @apply text-xs;
    }

    .experience-block {
      @apply pb-2;
    }

    .experience-block h4 {
      @apply my-2 text-sm font-medium;
    }

    .experience-block h5 {
      @apply text-sm font-medium;
    }

    .experience-block p,
    .experience-block li {
      @apply text-xs;
    }

    .experience-block ul {
      @apply mb-4 ml-8 text-sm;
      list-style: disc;
    }
  </style>
</Layout>
